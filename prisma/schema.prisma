generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Child {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  dob         DateTime
  dream       String
  imageUrl    String
  status      String
  story       String
  createdAt   DateTime @default(now())
}

# IremboPay Payment Gateway Configuration
# IMPORTANT: keys and environment must match, otherwise the JS widget opens
# but fails with "sorry we didn't receive your payment":
# - sandbox    -> test keys only (pk_test_... / sk_test_...), widget CDN is
#                 dashboard.sandbox.irembopay.com, test with MTN 0781234567,
#                 Airtel 0731234567, or card 4242 4242 4242 4242 (any future expiry).
# - production -> live keys only (pk_live_... / sk_live_...).
# Environment: 'sandbox' or 'production' (keep IPAY_ENVIRONMENT and
# NEXT_PUBLIC_IPAY_ENVIRONMENT identical).
IPAY_ENVIRONMENT=sandbox
NEXT_PUBLIC_IPAY_ENVIRONMENT=sandbox

# API Keys
NEXT_PUBLIC_IPAY_PUBLIC_KEY=pk_test_...
IPAY_PUBLIC_KEY=pk_test_...
IPAY_SECRET_KEY=sk_test_...

# Deposit Account Identifiers
IPAY_RWF_ACCOUNT_IDENTIFIER=Reclaim_Hope_RWF
IPAY_USD_ACCOUNT_IDENTIFIER=Reclaim_USD

# Product Catalog Codes
IPAY_PRODUCT_IDENTIFIER_RWF=PC-db88813cb2
IPAY_PRODUCT_IDENTIFIER_USD=PC-e8ac8ec873

# Callback Notification URL (registered in IremboPay Portal)
# In production: https://reclaimhope.rw/api/payments/irembo/callback
IPAY_CALLBACK_URL=https://reclaimhope.rw/api/payments/irembo/callback